{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "buildkit-cache"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "standard",
        "resources": {
          "requests": {
            "storage": "5Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "registry-data"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "standard",
        "resources": {
          "requests": {
            "storage": "5Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "registry"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "dev-registry"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "dev-registry"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "registry",
                "image": "REPLACED",
                "imagePullPolicy": "Never",
                "env": [
                  {
                    "name": "OTEL_TRACES_EXPORTER",
                    "value": "none"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 5000
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/v2/",
                    "port": 5000
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/registry"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "registry-data"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "registry"
      },
      "spec": {
        "type": "NodePort",
        "selector": {
          "app": "dev-registry"
        },
        "ports": [
          {
            "port": 5000,
            "targetPort": 5000,
            "nodePort": 30500
          }
        ]
      }
    }
  ]
}
