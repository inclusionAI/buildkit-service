{
  "kind": "Cluster",
  "apiVersion": "kind.x-k8s.io/v1alpha4",
  "nodes": [
    {
      "role": "control-plane",
      "extraPortMappings": [
        {
          "containerPort": 30500,
          "hostPort": 15000,
          "listenAddress": "127.0.0.1"
        }
      ]
    }
  ],
  "containerdConfigPatches": [
    "[plugins.\"io.containerd.grpc.v1.cri\".registry]\n  config_path = \"/etc/containerd/certs.d\""
  ]
}
